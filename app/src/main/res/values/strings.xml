    <!-- Pet: Sprechblasen. Leere Kategorie = das Pet sagt dazu nichts. -->
    <string-array name="pet_speech_start">
        <item>Da bist du ja.</item>
        <item>Guck mal, was heute ansteht.</item>
        <item>Ich hab auf dich gewartet.</item>
        <item>Fangen wir klein an.</item>
        <item>Moin.</item>
    </string-array>
    <string-array name="pet_speech_focus_begins">
        <item>Fünfundzwanzig Minuten. Ich bin still.</item>
        <item>Los geht\'s. Ich mach mir derweil nichts draus.</item>
        <item>Handy weg, ich pass auf.</item>
        <item>Eine Sache. Nur eine.</item>
        <item>Ich setz mich daneben.</item>
    </string-array>
    <string-array name="pet_speech_focus_ends">
        <item>Runde durch.</item>
        <item>Das war ordentlich.</item>
        <item>Kurz Luft holen.</item>
        <item>Steh mal auf, ja?</item>
        <item>Geschafft.</item>
    </string-array>
    <string-array name="pet_speech_break_over">
        <item>Pause vorbei.</item>
        <item>Noch eine Runde?</item>
        <item>Ich wär bereit.</item>
        <item>Weiter, solange es läuft.</item>
        <item>Zurück an die Sache.</item>
    </string-array>
    <string-array name="pet_speech_task_done">
        <item>Eine weniger.</item>
        <item>Abgehakt.</item>
        <item>Das hat gutgetan.</item>
        <item>Danke, ehrlich.</item>
        <item>Läuft doch.</item>
    </string-array>
    <string-array name="pet_speech_list_empty">
        <item>Nichts mehr offen. Ungewohnt.</item>
        <item>Leer. Genieß das.</item>
        <item>Alles weg für heute.</item>
        <item>Ich glaub, wir sind fertig.</item>
        <item>Feierabend.</item>
    </string-array>
    <string-array name="pet_speech_task_due">
        <item>Da wär was fällig.</item>
        <item>Das läuft dir gerade weg.</item>
        <item>Kurz draufschauen?</item>
        <item>Steht seit heute an.</item>
        <item>Nicht vergessen, ja?</item>
    </string-array>
    <string-array name="pet_speech_fed">
        <item>Mhh.</item>
        <item>Genau richtig.</item>
        <item>Das hat gefehlt.</item>
        <item>Danke.</item>
        <item>Satt.</item>
    </string-array>
    <string-array name="pet_speech_played">
        <item>Noch mal!</item>
        <item>Das war lustig.</item>
        <item>Ich bin ganz aus der Puste.</item>
        <item>Mehr davon.</item>
        <item>Gute Idee.</item>
    </string-array>
    <string-array name="pet_speech_patted">
        <item>Schön.</item>
        <item>Hmpf. Weiter.</item>
        <item>Genau da.</item>
        <item>Ich bleib kurz sitzen.</item>
        <item>Das mag ich.</item>
    </string-array>
    <string-array name="pet_speech_hungry">
        <item>Ich hätte Hunger.</item>
        <item>Mein Magen sagt was.</item>
        <item>Gibt\'s was?</item>
        <item>Nur ein Happen.</item>
        <item>Bisschen leer hier drin.</item>
    </string-array>
    <string-array name="pet_speech_tired">
        <item>Ich bin müde.</item>
        <item>Mir fallen die Augen zu.</item>
        <item>Kurz ausruhen?</item>
        <item>Puh.</item>
        <item>Nicht mehr viel übrig heute.</item>
    </string-array>
    <string-array name="pet_speech_sick">
        <item>Mir geht\'s nicht gut.</item>
        <item>Da liegt einiges herum.</item>
        <item>Räum eine Sache weg, dann wird\'s besser.</item>
        <item>Ich schaff das schon wieder.</item>
        <item>Eine reicht. Fang irgendwo an.</item>
    </string-array>
    <string-array name="pet_speech_happy">
        <item>Mir geht\'s gut.</item>
        <item>Schöner Tag.</item>
        <item>Ich sitz hier und freu mich.</item>
        <item>Alles bestens.</item>
        <item>Gute Laune, keine Ahnung warum.</item>
    </string-array>
    <string-array name="pet_speech_bored">
        <item>Und jetzt?</item>
        <item>Mir ist langweilig.</item>
        <item>Passiert heute noch was?</item>
        <item>Ich zähl schon Staubkörner.</item>
        <item>Sag Bescheid, wenn was ansteht.</item>
    </string-array>
