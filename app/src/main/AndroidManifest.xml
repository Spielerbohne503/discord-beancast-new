<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
        Akku-Ausnahme: bewusste Entscheidung aus dem Projektplan (Abschnitt 6.7). Ohne sie
        friert Android die App nach ein paar Tagen ein und die Erinnerungen fallen aus.
        Die App fragt sie einmalig im Onboarding und erklärt vorher, wofür.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".PetodoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PeTodo">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PeTodo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            "Teilen an PeTodo": der schnellste Weg, einen Link oder einen Gedanken aus
            einer anderen App hereinzubekommen. Ein Dialog über der teilenden App, kein
            eigener Bildschirm — man will dorthin zurück, wo man war.
        -->
        <activity
            android:name=".ui.share.ShareTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:theme="@style/Theme.PeTodo.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Fokus-Timer als Foreground Service. specialUse, weil ein Pomodoro-Timer in
            keine der engeren Kategorien passt; die Statuszeile ist ohnehin Pflicht.
        -->
        <service
            android:name=".data.focus.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pomodoro-Timer mit Statuszeile" />
        </service>

        <!-- Feuernder Alarm einer Aufgabe. Nicht exportiert: nur die App selbst löst aus. -->
        <receiver
            android:name=".data.alarm.NagReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="uk.spielerbohne.petodo.action.NAG" />
                <data android:scheme="petodo" />
            </intent-filter>
        </receiver>

        <!-- Aktionsknöpfe aus der Benachrichtigung: Erledigt / +1 Std / Morgen / Löschen. -->
        <receiver
            android:name=".data.alarm.TaskActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="uk.spielerbohne.petodo.action.TASK_ACTION" />
                <data android:scheme="petodo" />
            </intent-filter>
        </receiver>

        <!--
            Schnelleinstellungen-Kachel: Aufgabe erfassen, ohne die App zu suchen.
            Der Dienst darf nur vom System gebunden werden.
        -->
        <service
            android:name=".ui.tile.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Homescreen-Widget mit der Heute-Liste. Der Dienst füllt die Liste; er darf
            nur vom System gebunden werden, deshalb die Berechtigung.
        -->
        <receiver
            android:name=".data.widget.TodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <!--
                Nur APPWIDGET_UPDATE steht hier. Das Abhaken kommt über einen Entwurf mit
                ausdrücklich benanntem Empfänger und braucht deshalb keinen Filter — stünde
                es hier, könnte jede fremde App Aufgaben abhaken.
            -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <service
            android:name=".data.widget.TodayWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Alarme überleben keinen Neustart und kein App-Update. -->
        <receiver
            android:name=".data.alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
